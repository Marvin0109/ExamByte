# Rename this file to .env or create .env

# Replace dummies with your credentials for database connection
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Credentials of your custom OAuth App, installation guide:
# https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app
CLIENT_ID=
CLIENT_SECRET=

# 1. For using sonar, follow the following instructions: https://docs.sonarsource.com/sonarqube-server/try-out-sonarqube
# 2. Then generate a user token: https://docs.sonarsource.com/sonarqube-server/user-guide/managing-tokens
# 3. Replace SONAR_TOKEN with your token
# 4. Start the local instance of the Sonar server
# 5. Export your token in your terminal: export SONAR_TOKEN=... (To see if successful, execute: echo $SONAR_TOKEN)
# 6. Execute: ./gradlew clean build sonar -Dsonar.token=$SONAR_TOKEN
# 7. Open your browser and go to localhost:9000 and start inspecting your code smells
SONAR_TOKEN=